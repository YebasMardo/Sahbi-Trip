# Copy to .env and fill in real values. Never commit real secrets.

PORT=3000
# development | production | test
NODE_ENV=development
APP_NAME=Sahbi Trip
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Generate with: npm --prefix backend run generate:secret
JWT_SECRET=<REDACTED>
# Access token lifetime, e.g. 24 + h
ACCESS_TOKEN_TIME_VALUE=24
ACCESS_TOKEN_TIME_UNIT=h
# Refresh token lifetime, e.g. 30 + d
REFRESH_TOKEN_TIME_VALUE=30
REFRESH_TOKEN_TIME_UNIT=d

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Redis runs in Docker (see docker-compose.yml) — leave as-is for local/dev use.
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP transport used for OTP and welcome emails.
MAIL_HOST=<REDACTED>
MAIL_PORT=587
MAIL_USER=<REDACTED>
MAIL_PASSWORD=<REDACTED>
MAIL_FROM=<REDACTED>

# Anthropic Claude (LLM) — chat + tool calling. Not OpenAI-compatible: the
# Messages API is called directly from LlmClient, which translates to and from
# the OpenAI-shaped completion the rest of the ai module speaks. The base URL
# is not configurable (no self-hosted variant to point at).
ANTHROPIC_API_KEY=<REDACTED>
ANTHROPIC_MODEL=claude-haiku-4-5

# Voyage AI (embeddings + reranker). Called directly over fetch.
# LlmClient pins output_dimension to 1024 so the vectors keep matching
# numDimensions on the Atlas Vector Search index (backend/scripts/seed.ts) —
# switching embedding model needs no reseed as long as that stays 1024.
# Do not roll these back to voyage-3.x / rerank-2.x: deprecated, no free quota.
VOYAGE_API_KEY=<REDACTED>
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-3

AI_TIMEOUT_MS=90000

VITE_API_URL=http://localhost:3000
